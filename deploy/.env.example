# =====================================================================
#  ElectroShop — șablon variabile de mediu (copiază în host-ul plătit)
#  NU comite acest fișier completat cu valori reale în Git.
# =====================================================================

# ---------- Bază de date MySQL ----------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=electroshop
DB_USER=your-db-user
DB_PASSWORD=your-db-password
# Alternativ, în loc de cele 5 de mai sus, poți seta direct:
# SPRING_DATASOURCE_URL=jdbc:mysql://host:port/electroshop?useSSL=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=your-db-user
# SPRING_DATASOURCE_PASSWORD=your-db-password

# ---------- Securitate / JWT ----------
# String base64 de minim 256 biți. Generează unul NOU pentru producție, ex:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-new-base64-secret

# Parola inițială pentru contul de owner-admin (popa84@icloud.com)
OWNER_ADMIN_PASSWORD=change-me

# ---------- CORS (domeniul frontend-ului) ----------
CORS_ORIGINS=https://your-frontend-domain

# ---------- Cloudinary (imagini produse — feature #5) ----------
# Toate cele trei valori se citesc din Dashboard-ul Cloudinary, secțiunea
# "Product Environment Credentials". Fișierul acesta este un ȘABLON aflat
# într-un repository public: nu scrie aici cloud name-ul, cheia sau secretul
# real. Cheia de API nu semnează singură nicio cerere, dar împreună cu cloud
# name-ul identifică public contul și îi expune suprafața de atac, iar un
# șablon care conține jumătate din credențiale invită completarea celeilalte
# jumătăți direct în fișier. Valorile reale se setează exclusiv ca variabile
# de mediu în panoul host-ului.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------- JVM / performanță (opțional) ----------
JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xmx400m -Xss512k

# ---------- Frontend (Vite) ----------
# Se setează în serviciul de frontend, nu în backend:
# VITE_API_URL=https://your-backend-domain/api
