# Copy to ".env" for local overrides, or set in Vercel/Netlify project settings.
#
# Local development: leave empty — the Vite dev server proxies /api to localhost:8080.
# Production: set to your deployed backend base URL (must end with /api), e.g.
# VITE_API_URL=https://electroshop-backend.onrender.com/api

VITE_API_URL=
